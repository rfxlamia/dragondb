    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.2.0",
